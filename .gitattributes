# Normalize line endings across platforms.
# In the working tree Windows sees CRLF; the repo stores LF.
* text=auto eol=lf

# Windows-specific files keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files must not be touched.
*.wav   binary
*.png   binary
*.jpg   binary
*.ico   binary
