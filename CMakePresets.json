{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows (Visual Studio 2026, x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DRAUGHTS_BUILD_TESTS": "ON",
        "DRAUGHTS_BUILD_UI": "ON",
        "CMAKE_PREFIX_PATH": "C:/MyCodeApp/Qt/6.11.2/msvc2022_64"
      }
    },
    {
      "name": "windows-msvc-nogui",
      "inherits": "windows-msvc",
      "displayName": "Windows (Visual Studio 2026, x64, no GUI)",
      "binaryDir": "${sourceDir}/build-nogui",
      "cacheVariables": {
        "DRAUGHTS_BUILD_UI": "OFF"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DRAUGHTS_BUILD_TESTS": "ON",
        "DRAUGHTS_BUILD_UI": "OFF"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux (GCC, Debug + ASan/UBSan)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRAUGHTS_BUILD_TESTS": "ON",
        "DRAUGHTS_BUILD_UI": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-release",     "configurePreset": "windows-msvc",         "configuration": "Release" },
    { "name": "windows-debug",       "configurePreset": "windows-msvc",         "configuration": "Debug"   },
    { "name": "windows-nogui",       "configurePreset": "windows-msvc-nogui",   "configuration": "Release" },
    { "name": "linux-release",       "configurePreset": "linux-gcc-release" },
    { "name": "linux-debug",         "configurePreset": "linux-gcc-debug" }
  ],
  "testPresets": [
    {
      "name": "windows-release-tests",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release-tests",
      "configurePreset": "linux-gcc-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
